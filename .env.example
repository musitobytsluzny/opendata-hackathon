# One local configuration file for the entire development stack.
COMPOSE_FILE=infra/compose.dev.yml
HTTP_PORT=8080
DB_PORT=5432

POSTGRES_DB=opendata
POSTGRES_USER=opendata
POSTGRES_PASSWORD=opendata_dev
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

JWT_SECRET_KEY=local-development-secret-change-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Only VITE_* variables are exposed to the browser. Keep secrets unprefixed.
VITE_API_URL=/api
VITE_USE_MOCK_AUTH=false

MCP_DEBUG=true
CENTRAL_API_BASE_URL=http://api:8000
CENTRAL_API_KEY=
CENTRAL_API_TIMEOUT=30
