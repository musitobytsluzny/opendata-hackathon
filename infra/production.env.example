# Copy to .env.production and set values using Coolify's encrypted environment variables.
POSTGRES_DB=opendata
POSTGRES_USER=opendata
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
DATABASE_URL=postgresql://opendata:REPLACE_WITH_THE_SAME_PASSWORD@db:5432/opendata

JWT_SECRET_KEY=REPLACE_WITH_96_HEX_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_PROVIDER=vertex
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GOOGLE_ADC_HOST_PATH=/absolute/path/on/vps/google-application-credentials.json
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=2048
LLM_MAX_CONCURRENT=4
GEMINI_API_KEY=

MCP_DEBUG=false
CENTRAL_API_KEY=
CENTRAL_API_TIMEOUT=30
